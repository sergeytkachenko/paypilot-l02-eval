# cp .env.example .env, then fill in the key.

# Path to your paypilot-stand checkout on this computer; the rules engines
# are imported from it. Windows: C:/paypilot-stand
STAND_DIR=../paypilot-stand

# Judge key: the same one as in the stand's .env, or a Google AI Studio key for
# a Gemini judge. When several are set, Anthropic wins, then OpenAI, then Gemini.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Stand behind OpenRouter: the OpenRouter key goes into ANTHROPIC_API_KEY
# and ANTHROPIC_AUTH_TOKEN, plus the base URL.
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=

# Judge model, default claude-haiku-5-5 (Anthropic), gpt-4.1-mini (OpenAI)
# or gemini-3.5-flash-lite (Gemini). An empty value keeps the default.
# JUDGE_MODEL=

# Stand address as seen from the container. Defaults:
# eval       http://host.docker.internal:8000
# eval-host  http://127.0.0.1:8000
# Separate stand from this compose (docker compose up -d --build stand):
# EVAL_STAND_URL=http://stand:8000

# That separate stand: host port (127.0.0.1 only) and startup profile
# STAND_PORT=8010
# STAND_PROFILE=lesson-02

# Agent price in USD per million tokens, for the cost line of the report
# AGENT_PRICE_IN=1
# AGENT_PRICE_OUT=5
